---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/home/hero/Hero.astro";
import PoemSection from "../components/home/poem/Poem.astro";
import RealmsSection from "../components/home/realms/Realms.astro";
import Footer from "../components/home/Footer.astro";
import HR from "../components/home/HR.astro";
import Spacer from "../components/home/Spacer.astro";
import GodText from "../components/home/hero/GodText.astro";
import Starlight from "../components/home/hero/Starlight.astro";
---

<Layout title="MANAWAVE">
  <main>
    <div class="hero-stack">
      <div class="hero-content">
        <Spacer size="4rem" />
        <HR semantic={false} />
        <HeroSection />
        <Spacer size="7rem" />
        <HR />
      </div>
      <GodText />
      <Starlight />
    </div>
    <PoemSection />
    <RealmsSection />
    <Footer />
  </main>
</Layout>

<style>
  main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-auto-rows: auto;

    overflow-x: hidden;
  }

  /*
   * The god-text and the starlight video sit behind everything down to the
   * poem. This wrapper is a single explicit row: the sections stack inside
   * `.hero-content`, and both backdrops occupy that same one cell, so they
   * cover the run exactly without anybody counting row numbers. Two levels of
   * subgrid carry `main`'s centring tracks all the way down, so the backdrops
   * still land in the centre column.
   */
  .hero-stack {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    grid-template-rows: auto;
  }

  .hero-content {
    grid-area: 1 / 1 / 2 / -1;

    display: grid;
    grid-template-columns: subgrid;
    grid-auto-rows: auto;
  }
</style>
