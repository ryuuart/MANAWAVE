---
import { getCollection, getEntry } from "astro:content";
import Section from "../../../layouts/home/Section.astro";
import RealmItem from "./RealmItem.astro";

const allRealms = await Promise.all(
  (await getCollection("realms")).map(async (realm) => ({
    ...realm.data,
    url: `/realms/${realm.id}`,
    author: (await getEntry(realm.data.author))!.data,
  }))
);
---

<Section class="realms">
  <div class="name">
    <p>auravision ::</p>
  </div>
  <header id="realms">
    <h2>{allRealms.length} Realms</h2>
    <p>visions&nbsp;•&nbsp;dreams&nbsp;•&nbsp;self</p>
    <p class="description">
      There are untold ways to use <span class="manawave-text">manawave</span>.
      I offer to you {allRealms.length} examples, {allRealms.length} very different
      realms. See ways to wield <span class="manawave-text">manawave</span> by visiting
      each one.
    </p>
  </header>
  <ul>
    {
      allRealms.map((realm) => (
        <li>
          <RealmItem
            title={realm.title}
            tagline={realm.tagline}
            url={realm.url}
            color={realm.color.portal}
            author={realm.author}
          />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  section.realms {
    grid-template-rows: auto auto auto;
  }

  .name {
    grid-column: 1 / 1 / 2 / 2;

    display: flex;
    justify-content: end;

    margin-right: 0.5rem;
  }

  header {
    grid-area: 1 / 2 / 2 / 5;

    margin-left: 1rem;
  }

  ul {
    grid-area: 2 / 2 / 3 / 6;

    padding: 0;

    display: flex;
    flex-flow: column nowrap;

    gap: 2rem;

    margin: 4rem 0;
    margin-left: 1rem;
  }

  li {
    list-style: none;
  }

  h2 {
    text-transform: uppercase;

    margin: 0;
    margin-bottom: -0.5rem;
  }

  p {
    margin: 0;

    font-size: 0.75rem;
  }

  .description {
    font-size: 1rem;
    margin: 1rem auto;
  }
</style>
