---
import Block from "./Block.astro";

const { class: className } = Astro.props;
---

<Block>
  <!-- spans the whole block so `block-subgrid` can adopt its five tracks -->
  <section
    class:list={[className, "block-subgrid", "col-span-full", "row-span-full"]}
  >
    <slot />
  </section>
</Block>
