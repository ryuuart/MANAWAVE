{
  "name": "manawave",
  "license": "MIT",
  "author": "Long Nguyen",
  "version": "0.13.0",
  "homepage": "https://manawave.art/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuuart/manawave.git"
  },
  "description": "It's not a marquee, it's more than that!",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/manawave.js",
      "require": "./dist/manawave.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/manawave.umd.cjs",
  "module": "./dist/manawave.js",
  "unpkg": "./dist/manawave.min.js",
  "jsdelivr": "./dist/manawave.min.js",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "tsc",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest --project chrome",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "marquee",
    "ticker",
    "scroller",
    "animation",
    "web-component",
    "vanilla-js"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@vitest/browser-webdriverio": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "webdriverio": "catalog:"
  }
}
